# STAXK environment — copy to .env.local and fill in.
# With NO env vars set, the app runs in DEMO MODE with seeded data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never in client-reachable code

ANTHROPIC_API_KEY=                  # agent reasoning
OPENAI_API_KEY=                     # embeddings only (or VOYAGE_API_KEY)
VOYAGE_API_KEY=

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

APOLLO_API_KEY=                     # or HUNTER_API_KEY
HUNTER_API_KEY=
SERPAPI_KEY=

X_BEARER_TOKEN=                     # Pulse: X/Twitter API (basic tier)
REDDIT_CLIENT_ID=                   # Pulse: Reddit API (free)
REDDIT_CLIENT_SECRET=

STAXK_USER_ID=                      # your auth.users id (single-user app)
OUTREACH_FROM=                      # "Halania Dixon <hello@alaniarenee.dev>" — dedicated domain, never your primary
PHYSICAL_ADDRESS=                   # CAN-SPAM footer (a P.O. box works)

# Hard caps (Failure mode #4: cost creep)
MAX_EMAILS_PER_DAY=10               # warm-up: 10/day weeks 1-2, then 25
MAX_TOUCHES_PER_CONTACT=3
