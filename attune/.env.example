# Required — your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override the models used.
# Conversation runs on a fast, capable model; the debrief can use a stronger one.
# ATTUNE_CONVERSE_MODEL=claude-sonnet-5
# ATTUNE_DEBRIEF_MODEL=claude-sonnet-5
